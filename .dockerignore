# Keep build contexts small and secret-free: dependencies are installed inside
# the image, and no local env file ever reaches an image.
**/node_modules
**/.next
**/.turbo
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/*.tsbuildinfo
.git
.github
.husky
.unlighthouse
coverage
deploy
docs
Joined-Logo
**/bin
**/*.test
