# Server-only. The Joined API (joined-backend).
JOINED_API_URL=http://127.0.0.1:8080

# Public origin of this app. Absolute URLs in sitemap, robots, and JobPosting JSON-LD.
JOINED_WEB_URL=http://127.0.0.1:6002

# Google Search Console (HTML tag method) — content value only, not the full meta tag.
GOOGLE_SITE_VERIFICATION=

# Optional: HTML file method is served from public/google2ed8ee3d9b3b9452.html (no env).
# GTM + GA4 snippets (Search Console can verify via Tag Manager or Analytics accounts).
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Server-only. Geoapify autocomplete for headquarters and offices.
# https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Feature flag: enable company/recruiter mode (default: false for launch).
# When false, all company routes redirect to /, company UI is hidden, and sign-up only offers candidate mode.
# When true, company mode works as before.
NEXT_PUBLIC_COMPANY_MODE_ENABLED=false

# Joined Premium prices in cents. Same names as backend-core/billing (step-29).
# Defaults: 2900 monthly, 29000 yearly.
PREMIUM_MONTHLY_PRICE_CENTS=2900
PREMIUM_YEARLY_PRICE_CENTS=29000

# Checkout kill switch. Set to false to hide Upgrade and show a notice.
# Defaults to enabled when unset.
BILLING_CHECKOUT_ENABLED=true
