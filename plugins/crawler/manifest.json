{
  "manifest_version": 3,
  "name": "Joined Scrapper",
  "version": "2.5.6",
  "description": "Joined staff browser tool to scrape job listings into the admin pool.",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Joined Scrapper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
