# Copy to .env and rebuild (`bun run build:crawler`); Vite bakes these into the extension.

# Joined admin API base. Locally: the admin-backend's HTTP_ADDR (default 127.0.0.1:8081).
VITE_API_URL=http://127.0.0.1:8081

# Same value as CRAWLER_INGEST_TOKEN in admin-backend/.env. Generate one with: openssl rand -hex 32
VITE_CRAWLER_INGEST_TOKEN=

# Days (1–365) a job already in temp_jobs (staged) or jobs (posted) counts as a
# duplicate: same apply link, or same company and title.
VITE_DUPLICATE_WINDOW_DAYS=30

# Optional: the createdBy value staff filter on ("Job scrape source"). Default: joined-scrapper.
# VITE_SCRAPE_SOURCE=joined-scrapper
