# Normalize text files and store them in Git using LF.
* text=auto eol=lf

# Shell scripts must use LF.
*.sh text eol=lf

# Windows-native scripts may use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
