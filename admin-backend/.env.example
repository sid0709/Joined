# The database every backend service shares.
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/
DEST_DB=JoinedDB
DEST_COLLECTION=temp_jobs
JOBS_COLLECTION=jobs
COMPANIES_COLLECTION=companies
# Copied companies wait here until research publishes them to COMPANIES_COLLECTION.
TEMP_COMPANIES_COLLECTION=temp_companies
# Where Migration (and cmd/copyjobs, cmd/copycompanies) copy from.
SOURCE_DB=AthensDB
SOURCE_COLLECTION=jobs
SOURCE_COMPANIES=companies

HTTP_ADDR=127.0.0.1:8081
# Browser origins that may call this API directly. admin-frontend calls it from its server.
CORS_ORIGINS=http://127.0.0.1:6010,http://localhost:6010

# Scout jobs analysis.
# Same value as backend-core's: it opens the API key saved in the console (Settings → Acorn AI).
# SETTINGS_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Migration: analyzes copied jobs and researches companies with web search. Company
# autofill uses it too. Web search runs on DeepSeek's side through DEEPSEEK_SEARCH_URL,
# its Anthropic-format endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_URL=https://api.deepseek.com/anthropic
# Most web searches behind one company research. Fewer is faster; more finds more.
DEEPSEEK_MAX_SEARCHES=4
# How many jobs / companies the AI steps work on at once.
MIGRATION_ANALYZE_WORKERS=64
MIGRATION_RESEARCH_WORKERS=128

# Sign in with Google for staff: the admin OAuth client (Google Cloud project
# joined-admin → Credentials → Web application), with GOOGLE_SIGNIN_REDIRECT_URL listed
# as an Authorized redirect URI. Once set, every console page needs a staff session.
# Leave GOOGLE_CLIENT_ID blank to run the console without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# admin-frontend's callback page. Open the console on this same host (localhost, not
# 127.0.0.1) or the sign-in cookie is lost.
GOOGLE_SIGNIN_REDIRECT_URL=http://localhost:6010/auth/google/callback
# The staff Google Workspace domain. Only accounts it manages can sign in; blank lets
# nobody in.
ADMIN_GOOGLE_DOMAIN=

# Every route but /health requires this bearer token when set.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=
