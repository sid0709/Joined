# The database every backend service shares.
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/
DEST_DB=OpenedDB
DEST_COLLECTION=temp_jobs
JOBS_COLLECTION=jobs
COMPANIES_COLLECTION=companies
# Where "copy jobs" and cmd/copyjobs, cmd/copycompanies read from.
SOURCE_DB=AthensDB
SOURCE_COLLECTION=jobs
SOURCE_COMPANIES=companies

HTTP_ADDR=127.0.0.1:8081
# Browser origins that may call this API directly. joined-admin calls it from its server.
CORS_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Model for company autofill, which searches the web. Blank uses OPENAI_MODEL.
OPENAI_SEARCH_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Every route but /health requires this bearer token when set.
# Generate one with: openssl rand -hex 32
ADMIN_API_TOKEN=
