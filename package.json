{
  "name": "joined",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "connected-frontend",
      "joined-theme",
      "joined-frontend",
      "admin-frontend",
      "scoutwell-frontend",
      "packages/*",
      "acorn/extension",
      "acorn/packages/*",
      "acorn/demo",
      "plugins/crawler",
      "scout-extension"
    ],
    "catalog": {
      "@astryxdesign/cli": "0.6.3",
      "@astryxdesign/core": "0.6.3",
      "@astryxdesign/theme-neutral": "0.6.3",
      "@commitlint/cli": "21.2.3",
      "@commitlint/config-conventional": "21.2.3",
      "@crxjs/vite-plugin": "2.7.1",
      "@stylexjs/stylex": "0.19.1",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.2",
      "@types/chrome": "0.0.287",
      "@types/node": "20.19.43",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@unlighthouse/cli": "0.18.1",
      "@vitejs/plugin-react": "6.1.1",
      "eslint": "9.39.5",
      "eslint-config-next": "16.3.6",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-import": "2.32.0",
      "eslint-plugin-react-hooks": "7.1.1",
      "husky": "9.1.7",
      "lint-staged": "17.6.0",
      "next": "16.3.6",
      "prettier": "3.9.9",
      "puppeteer": "25.12.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "sharp": "0.35.4",
      "socket.io-client": "4.8.3",
      "tailwindcss": "4.3.3",
      "turbo": "2.11.4",
      "typescript": "5.9.3",
      "typescript-eslint": "8.70.1",
      "vite": "8.3.1"
    }
  },
  "overrides": {
    "@types/node": "20.19.43"
  },
  "scripts": {
    "dev": "bun tools/dev-all.mjs",
    "dev:joined": "bun tools/run-service.mjs dev joined-frontend",
    "dev:admin": "bun tools/run-service.mjs dev admin-frontend",
    "dev:api": "bun tools/run-api.mjs",
    "dev:joined-api": "bun tools/run-api.mjs joined-api",
    "dev:admin-api": "bun tools/run-api.mjs admin-api",
    "dev:scout-api": "bun tools/run-api.mjs scout-api",
    "dev:core-api": "bun tools/run-api.mjs core-api",
    "dev:app": "bun tools/run-service.mjs dev connected-frontend",
    "dev:theme": "bun tools/run-service.mjs dev joined-theme",
    "dev:scout": "bun tools/run-service.mjs dev scoutwell-frontend",
    "dev:acorn": "bun --filter acorn-extension dev",
    "dev:acorn-face": "bun --filter @acorn/face dev",
    "dev:crawler": "bun --filter avalon-scrapper dev",
    "build": "turbo run build",
    "build:joined": "bun --filter joined-frontend build",
    "build:app": "bun --filter connected-frontend build",
    "build:theme": "bun --filter joined-theme build",
    "build:scout": "bun --filter scoutwell-frontend build",
    "build:admin": "bun --filter admin-frontend build",
    "build:acorn": "bun --filter acorn-extension build",
    "build:crawler": "bun --filter avalon-scrapper build",
    "build:frontends": "bun run build:app && bun run build:joined && bun run build:scout && bun run build:admin",
    "audit": "bun tools/audit-all-frontends.mjs",
    "audit:joined": "bun tools/unlighthouse-target.mjs joined-frontend",
    "audit:joined:company": "bun tools/unlighthouse-target.mjs joined-frontend --site http://localhost:6002/company",
    "audit:app": "bun tools/unlighthouse-target.mjs connected-frontend",
    "audit:scout": "bun tools/unlighthouse-target.mjs scoutwell-frontend",
    "audit:theme": "bun tools/unlighthouse.mjs --site http://localhost:6001 --disable-dynamic-sampling",
    "audit:admin": "bun tools/unlighthouse-target.mjs admin-frontend",
    "start:frontends": "bun tools/start-frontends.mjs",
    "start:joined": "bun tools/run-service.mjs start joined-frontend",
    "start:app": "bun tools/run-service.mjs start connected-frontend",
    "start:theme": "bun tools/run-service.mjs start joined-theme",
    "start:scout": "bun tools/run-service.mjs start scoutwell-frontend",
    "start:admin": "bun tools/run-service.mjs start admin-frontend",
    "lint": "bun run lint:workspaces && bun run lint:repo",
    "lint:workspaces": "turbo run lint",
    "lint:repo": "eslint eslint.config.mjs eslint.shared.mjs commitlint.config.mjs tools tests --max-warnings=0",
    "lint:fix": "turbo run lint:fix && eslint eslint.config.mjs eslint.shared.mjs commitlint.config.mjs tools tests --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "theme:build": "bun --filter @joined/design-system theme:build",
    "brand:icons": "bun tools/sync-app-icons.mjs",
    "test": "bun test --coverage --coverage-reporter=lcov && bun run check:test-policy",
    "test:go": "bun tools/go.mjs test",
    "vet:go": "bun tools/go.mjs vet",
    "check:boundaries": "bun tools/check-workspace-boundaries.mjs",
    "check:test-policy": "bun tools/check-test-policy.mjs",
    "check:deps": "bun tools/check-single-node-modules.mjs",
    "ci": "bun tools/ci.mjs",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "@unlighthouse/cli": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "puppeteer": "catalog:",
    "turbo": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "prettier --write",
    "**/*.{json,css,scss,md,mdx,yml,yaml}": "prettier --write"
  }
}
