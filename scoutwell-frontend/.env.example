# Server-only. The Joined API (joined-backend).
JOINED_API_URL=http://127.0.0.1:8080

# Optional. The API base URL shown to partners in the developer docs, when it
# differs from JOINED_API_URL (for example a public gateway).
SCOUT_PUBLIC_API_URL=

# Optional. Joined's public site, so approved jobs link to their live page.
JOINED_WEB_URL=http://127.0.0.1:3002

# Server-only. Geoapify autocomplete for the job location field.
# https://www.geoapify.com/
GEOAPIFY_API_KEY=
