# Server-only. The Scoutwell API (scoutwell-backend).
SCOUTWELL_API_URL=http://127.0.0.1:8082

# Optional. The API base URL shown to partners in the developer docs, when it
# differs from SCOUTWELL_API_URL (for example a public gateway).
SCOUT_PUBLIC_API_URL=

# Optional. Joined's public site, so approved jobs link to their live page.
JOINED_WEB_URL=http://127.0.0.1:6002

# Optional. Chrome Web Store listing for the Scout extension. Empty until the
# listing is published (roadmap step-15); the install page shows a placeholder.
SCOUT_EXTENSION_STORE_URL=

# Server-only. Geoapify autocomplete for the job location field.
# https://www.geoapify.com/
GEOAPIFY_API_KEY=
