{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "JOINED_API_URL",
        "SCOUTWELL_API_URL",
        "SCOUT_PUBLIC_API_URL",
        "JOINED_WEB_URL",
        "VITE_ACORN_API_URL",
        "VITE_JOINED_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    }
  }
}
