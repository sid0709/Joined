# acorn-backend. The site calls it from the server and stores the session cookie.
ACORN_API_URL=http://127.0.0.1:8083

# Optional install URL for the landing-page extension button (Chrome Web Store
# or a sideload page). When empty, the button jumps to the on-page install note.
ACORN_EXTENSION_INSTALL_URL=

# Optional packed extension (.zip) the Apps page offers for sideloading.
ACORN_EXTENSION_DOWNLOAD_URL=
