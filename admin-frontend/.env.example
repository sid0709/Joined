# Server-only. The admin API (admin-backend). The browser never calls it directly.
ADMIN_API_URL=http://127.0.0.1:8081

# Server-only. Must match ADMIN_API_TOKEN in admin-backend/.env when that is set.
ADMIN_API_TOKEN=

# Recorded as the actor on staff decisions in the audit log.
ADMIN_ACTOR=admin console

# Optional. Joined's public site, for links to published jobs.
JOINED_WEB_URL=http://127.0.0.1:3002

# Server-only. Geoapify autocomplete for headquarters and offices.
# https://www.geoapify.com/
GEOAPIFY_API_KEY=
