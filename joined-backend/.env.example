# The database every backend service shares.
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/
DEST_DB=JoinedDB
DEST_COLLECTION=temp_jobs
JOBS_COLLECTION=jobs
COMPANIES_COLLECTION=companies
# Copied companies research has not published yet.
TEMP_COMPANIES_COLLECTION=temp_companies

HTTP_ADDR=127.0.0.1:8080
# Browser origins that may call this API directly. joined-frontend calls it from its server.
CORS_ORIGINS=http://127.0.0.1:6002,http://localhost:6002

# Create the job search text index at startup (dev only; production creates it manually).
SEARCH_ENSURE_INDEX=true

# Dead-link expiry checker. Off by default. Enable only in environments that
# should HEAD/GET apply links (polite rate limit, honest User-Agent).
JOBS_EXPIRY_CHECKER_ENABLED=false

# Recruiter / company APIs. Off for launch; set true with the frontend flag.
COMPANY_MODE_ENABLED=false

# Stripe test-mode Premium billing. Unset leaves /v1/me/billing and /v1/webhooks/stripe unmounted.
# Live keys (sk_live_ or rk_live_) require STRIPE_ALLOW_LIVE=true. Leave that unset.
# Optional price ids override lookup keys. Names only; do not paste live secrets here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_ACORN_MONTHLY_PRICE_ID=
STRIPE_ACORN_YEARLY_PRICE_ID=
# Acorn Pro prices in cents. Defaults are 1900 and 18000. Free and Unlimited are not Stripe products.
ACORN_MONTHLY_PRICE_CENTS=
ACORN_YEARLY_PRICE_CENTS=

# Reads job descriptions recruiters paste in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# joined-frontend, for links and redirects back to it.
FRONTEND_ORIGIN=http://localhost:6002

# Google Cloud → Credentials → OAuth client (Web application). Both redirect URLs
# below must be listed on that client as Authorized redirect URIs, exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Google, the only way to sign in or sign up for job hunters and
# recruiters: joined-frontend's callback page. Open the
# app on this same host (localhost, not 127.0.0.1) or the sign-in cookie is lost.
GOOGLE_SIGNIN_REDIRECT_URL=http://localhost:6002/api/auth/google/callback
# Settings → Connect Google Calendar: this API's calendar callback.
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/v1/me/calendar/google/callback

# Runtime kill switches. Unset leaves the feature on. off/false/0/no/disabled turns it off
# until staff override it in Mongo. Scout submissions and checkout are flipped here too;
# Penny wires those checks in Scoutwell and billing (see backend-core/killswitch/README.md).
# KILLSWITCH_SIGNUP=on
# KILLSWITCH_EMAIL=on
# KILLSWITCH_JOB_IMPORTS=on
# KILLSWITCH_ACORN_AI=on
# KILLSWITCH_SCOUT_SUBMISSIONS=on
# KILLSWITCH_CHECKOUT=on
# KILLSWITCH_CACHE_MS=5000

# Personalized ranking (backend-core/ranking/README.md). Start the services with
# `bun run dev:ranking`. Leave these blank and search ranks from the in-memory
# index alone; typed queries then fall back to the Mongo text search.
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379/0
EMBEDDER_URL=http://127.0.0.1:8090
# tei (text-embeddings-inference) or openai (any OpenAI-compatible /v1/embeddings).
# EMBEDDER_API=tei
# EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDER_DIMENSIONS=384
# Mirror Mongo into Qdrant from this process. Turn it on in one instance only.
RANKING_INDEXER=true
# Log impressions and interactions (training data). Off keeps local runs from
# writing to a shared database.
# RANKING_EVENTS=true
# A LightGBM model from tools/ranking/train_ltr.py, and the share of signed-in
# users (stable by user) who get it instead of the hand-tuned weights.
# RANKING_MODEL_PATH=
# RANKING_LTR_PERCENT=0

# Prometheus metrics on a listener of their own (never the public HTTP_ADDR).
# Blank leaves them off. Production sets :9464 inside the compose network.
# METRICS_ADDR=127.0.0.1:9464
# Optional monitoring. Empty means no outbound error tracker and no uptime ping.
# /health stays up without either value.
SENTRY_DSN=
UPTIME_PING_URL=
