{
  "name": "@joined/design-system",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/components/index.ts",
    "./places": "./src/components/places.ts",
    "./geoapify": "./src/places/geoapify.ts",
    "./styles.css": "./src/styles/theme.css",
    "./styles/astryx.css": "./src/styles/astryx.css",
    "./styles/components.css": "./src/styles/components.css",
    "./styles/joined.css": "./src/styles/joined.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./theme": "./src/theme/index.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "theme:build": "astryx theme build src/theme/joined.theme.ts -o src/theme/theme.css"
  },
  "dependencies": {
    "@astryxdesign/core": "catalog:",
    "@astryxdesign/theme-neutral": "catalog:",
    "@stylexjs/stylex": "catalog:"
  },
  "devDependencies": {
    "@astryxdesign/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
