# The database every backend service shares.
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/
DEST_DB=JoinedDB
DEST_COLLECTION=temp_jobs
JOBS_COLLECTION=jobs
COMPANIES_COLLECTION=companies
# Copied companies research has not published yet.
TEMP_COMPANIES_COLLECTION=temp_companies

HTTP_ADDR=127.0.0.1:8082
# Browser origins that may call this API directly. scoutwell-frontend calls it from its
# server, and partners call it with scout API keys.
CORS_ORIGINS=http://127.0.0.1:3003,http://localhost:3003

# Sign in with Google for scouts: Scoutwell's own OAuth client (Google Cloud project
# joined-scout → Credentials → Web application), with GOOGLE_SIGNIN_REDIRECT_URL
# listed as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# scoutwell-frontend's callback page. Open the app on this same host (localhost,
# not 127.0.0.1) or the sign-in cookie is lost.
GOOGLE_SIGNIN_REDIRECT_URL=http://localhost:3003/auth/google/callback
