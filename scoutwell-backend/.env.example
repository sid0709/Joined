# The database every backend service shares.
MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/
DEST_DB=OpenedDB
DEST_COLLECTION=temp_jobs
JOBS_COLLECTION=jobs
COMPANIES_COLLECTION=companies

HTTP_ADDR=127.0.0.1:8082
# Browser origins that may call this API directly. scoutwell-frontend calls it from its
# server, and partners call it with scout API keys.
CORS_ORIGINS=http://127.0.0.1:3003,http://localhost:3003
