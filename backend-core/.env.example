# Same database as joined-backend: Oak reads Joined accounts, sessions and profiles from it.
MONGO_URI=
# DEST_DB=JoinedDB

# The model behind AI Analyze, Q&A, option matching and JD extraction.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where Oak listens and which browser origins (the UI board) may call it.
# HTTP_ADDR=127.0.0.1:8980
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Name of the cookie joined-frontend keeps the Joined session token in.
# JOINED_SESSION_COOKIE=joined_session

# A file the extension may attach to an upload field when no résumé is available.
# OAK_RUNTIME_FILE_PATH=
# OAK_RUNTIME_FILE_KEY=runtime_file
