# backend-core's server: the API at api.joinedhq.com. Acorn lives under /acorn.

# Same database as joined-backend: Acorn reads Joined accounts, sessions and profiles from it.
# Copy joined-backend/.env's value exactly — a different database rejects every Joined session (401).
MONGO_URI=
# DEST_DB=JoinedDB

# Staff can also save the OpenAI key and pick the model in the admin console (Settings →
# Acorn AI). That key is stored encrypted with this one, so backend-core and admin-backend
# must share it: `openssl rand -base64 32`. A saved key wins over OPENAI_API_KEY below.
# SETTINGS_ENCRYPTION_KEY=

# The model behind Acorn's AI Analyze, Q&A, option matching and JD extraction.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where the server listens and which browser origins (Acorn's UI board) may call it.
# HTTP_ADDR=127.0.0.1:8083
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Name of the cookie joined-frontend keeps the Joined session token in.
# JOINED_SESSION_COOKIE=joined_session

# A file the Acorn extension may attach to an upload field when no résumé is available.
# ACORN_RUNTIME_FILE_PATH=
# ACORN_RUNTIME_FILE_KEY=runtime_file

# Runtime kill switches. Unset leaves the feature on. off/false/0/no/disabled turns it off.
# KILLSWITCH_ACORN_AI=on
# KILLSWITCH_CACHE_MS=5000
