# backend-core's server: the API at api.joinedhq.com. Bash lives under /bash.

# Same database as joined-backend: Bash reads Joined accounts, sessions and profiles from it.
MONGO_URI=
# DEST_DB=JoinedDB

# The model behind Bash's AI Analyze, Q&A, option matching and JD extraction.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where the server listens and which browser origins (Bash's UI board) may call it.
# HTTP_ADDR=127.0.0.1:8083
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Name of the cookie joined-frontend keeps the Joined session token in.
# JOINED_SESSION_COOKIE=joined_session

# A file the Bash extension may attach to an upload field when no résumé is available.
# BASH_RUNTIME_FILE_PATH=
# BASH_RUNTIME_FILE_KEY=runtime_file
