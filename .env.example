# `bun run audit` test mode. When true, each app is scanned signed in as a pinned test account:
# a one-hour session, revoked when the scan ends. Use a dedicated test account, never a real user.
AUDIT_TEST_MODE=false

# Joined test account: its `id` field in the users collection (not `_id`) and its email.
# Both must name the same account, or the audit refuses to sign in.
AUDIT_TEST_USER_ID=
AUDIT_TEST_EMAIL=

# Optional Scoutwell test account (role "scout"). Left blank, Scoutwell is scanned signed out.
AUDIT_SCOUT_USER_ID=
AUDIT_SCOUT_EMAIL=

# The admin console is signed in only when admin-backend's MONGO_URI is a local database.
