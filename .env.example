# Audit test mode for `bun run audit`.
# Set AUDIT_TEST_MODE=true in .env to sign in to each app before Unlighthouse scans it.
AUDIT_TEST_MODE=false

# Email and password, typed into the sign-in form (joined and connected).
AUDIT_JOINED_EMAIL=
AUDIT_JOINED_PASSWORD=
AUDIT_CONNECTED_EMAIL=
AUDIT_CONNECTED_PASSWORD=

# Session cookie, `name=value`, copied from a signed-in browser (scoutwell and admin sign in with Google only).
AUDIT_SCOUTWELL_COOKIE=
AUDIT_ADMIN_COOKIE=
