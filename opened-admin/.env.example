# Server-only. The Opened API (opened-backend). The browser never calls it directly.
ADMIN_API_URL=http://127.0.0.1:8080

# Server-only. Must match ADMIN_API_TOKEN in opened-backend/.env when that is set.
ADMIN_API_TOKEN=

# Recorded as the actor on staff decisions in the audit log.
ADMIN_ACTOR=admin console

# Optional. Opened's public site, for links to published jobs.
OPENED_WEB_URL=http://127.0.0.1:3002

# Server-only. Geoapify autocomplete for headquarters and offices.
# https://www.geoapify.com/
GEOAPIFY_API_KEY=
